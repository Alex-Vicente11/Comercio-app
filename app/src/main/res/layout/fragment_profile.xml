<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    tools:context=".ui.profile.ProfileFragment">

  <TextView
      android:id="@+id/profileId"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="Cargando perfil..."
      android:textSize="18sp"
      android:textAlignment="center"
      android:padding="28dp"
      android:background="@android:color/holo_blue_light"
      android:textColor="@android:color/white"
      android:layout_margin="16dp"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      tools:text="Perfil de: Juan Pérez\nID: 123"
      />

  <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:background="@android:color/holo_green_light"
      android:gravity="center"
      android:padding="16dp"
      android:text="¡Sesión Iniciada!\n\nEste usuario ahora está &quot; logueado&quot; en la app. \n\nFuturas funcionalidades:\n Carrito de compras personalizado\n Historial de pedidos\n "
      android:textColor="@android:color/white"
      android:textSize="14sp"
      app:layout_constraintTop_toBottomOf="@id/profileId"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>